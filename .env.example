APP_ENV=local
APP_NAME=inventory-api
LOG_LEVEL=INFO

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_MINUTES=1440
AUTH_ENABLED=true

# Local sem Docker: deixe DATABASE_URL vazio para usar SQLite.
DATABASE_URL=
SQLITE_URL=sqlite+aiosqlite:///./inventory.db

# Local com Postgres via docker-compose, se quiser usar depois:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/inventory

ALLOW_NEGATIVE_STOCK=false
IDEMPOTENCY_REQUIRED_IN_PRODUCTION=true

CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Rate limiting (requests per minute per IP, 0 disables). Behind a proxy
# (Render, Vercel) set RATE_LIMIT_TRUSTED_PROXY_HOPS to the number of proxies in front of the API.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Error reporting (Sentry). Empty = off.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
