APP_ENV=local
APP_NAME=inventory-api
LOG_LEVEL=INFO

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_MINUTES=1440
AUTH_ENABLED=true

# Produção (Vercel + Supabase/Neon/Render/RDS): use a URL PostgreSQL em DATABASE_URL.
# Local com Postgres (docker-compose):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/inventory
# Local opcional com SQLite (quando DATABASE_URL estiver vazio):
SQLITE_URL=sqlite+aiosqlite:///./inventory.db

ALLOW_NEGATIVE_STOCK=false
IDEMPOTENCY_REQUIRED_IN_PRODUCTION=true

CORS_ORIGINS=*
